# Copy to .env and fill in. NEVER commit this file or paste values in chat.

# --- Option A: automatic refresh (required for the collector) ---
# These three together grant FULL account access including orders.
# In GCP put them in Secret Manager, not on the VM.
DHAN_CLIENT_ID=100xxxxxxx
DHAN_PIN=your_numeric_pin
DHAN_TOTP_SECRET=base32_seed_from_authenticator

# --- Option B: static token, one-off scripts only (expires in ~24h) ---
# DHAN_ACCESS_TOKEN=eyJ...

GCP_PROJECT_ID=your-project
GCS_BUCKET=your-bucket
